---
import { Image } from "astro:assets";
import headshot from "../assets/vitor-headshot.jpg";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * Homepage — Hero + "What I'm building" 4-card section + footer with
 * sibling sites + build stamp.
 *
 * Mono-forward print-engineering aesthetic with hi-vis amber signature.
 * Section numbers as anchors. Staggered fadeUp on first paint.
 *
 * Hero photo: right-aligned circular ~240px, quiet treatment — pure
 * circle, no amber ring, lets amber stay typographic. Bio is 1 paragraph;
 * dossier density (credentials / Linux history) lives on /about.
 *
 * Featured projects: 4 cards — AI & PM Research Hub (Co-founder; platform
 * and framework author), MeridianIQ (Author), Panorama (Author), Orenu
 * (Founder — solo). Role taxonomy distinguishes collective initiatives
 * (Co-founder) from sole-founder solo work (Founder). Naming convention:
 * English-primary with PT name in parens.
 */

const title = "Vitor M. Rodovalho";
const description =
  "Senior Cost Manager at Linesight · hyperscale data center delivery · co-founder of the AI & PM Research Hub at PMI Brazil and author of its open-source platform · open-source builder of MeridianIQ + Panorama. 15+ years across U.S. and Brazil.";

const featured = [
  {
    slug: "nucleo-ia-gp",
    name: "AI & PM Research Hub",
    nameAlt: "Núcleo IA & GP",
    role: "Co-founder",
    tagline: "Voluntary inter-chapter PMI® Brazil research initiative on AI ⨯ Project Management",
    blurb:
      "Anchored by an open-source platform that binds the management framework, structures procedural and information flow, and gamifies the volunteer journey — where AI is both research subject and operational substrate. 50+ volunteers across federated Brazilian chapters in research streams and operational workgroups. Multi-tenant: governance chains, LGPD-by-design, trilingual UX (EN · PT · ES), MCP-based AI integration with Drive · GitHub · Canva · Credly · PMI VEP · Calendar · WhatsApp. Designed so any PMI chapter globally can adopt the operational model. Co-founded 2024 as a PMI Goiás pilot; the open-source platform and the management framework are authored and documented by Vitor. Inter-institutional collaborations welcome.",
    href: "https://nucleoia.vitormr.dev",
  },
  {
    slug: "meridianiq",
    name: "MeridianIQ",
    role: "Author",
    tagline: "The intelligence standard for project schedules",
    blurb:
      "Open-source schedule intelligence platform — from validation to prediction to cost-schedule integration. Built for schedulers, project controls professionals, and forensic delay analysts: transparent, auditable, free. Every methodology traces to published standards (AACE RP, DCMA 14-Point, SCL Protocol, GAO Schedule Assessment Guide). 48 analysis engines, 22 Claude MCP tools, 1,679+ tests, 129 API endpoints, 55 SvelteKit pages. P6 XER + MS Project XML. v4.3.0 in production · MIT.",
    href: "https://meridianiq.vitormr.dev",
  },
  {
    slug: "panorama",
    name: "Panorama",
    role: "Author",
    tagline: "One open-source platform for IT assets AND operational fleet",
    blurb:
      "Laptops, vehicles, licenses, equipment — in one pane. Multi-tenant Postgres RLS, OIDC, hash-chained audit, trilingual EN/PT-BR/ES. AGPL-3.0 (fork-friendly). Free hosted preview coming.",
    href: "https://panorama.vitormr.dev",
  },
  {
    slug: "orenu",
    name: "Orenu",
    role: "Founder",
    tagline: "Family fintech for cross-border BR↔US households",
    blurb:
      "Four domain pillars (Financial · Tax · Wealth · Immigration) anchored by an AI-augmented data layer; cross-cutting estate-continuity and insurance-planning meta-layers. Private platform — invite-only beta planned.",
    href: "https://orenu.vitormr.dev",
  },
];

---

<BaseLayout title={title} description={description}>
  <main class="flex-1 px-6 sm:px-10 lg:px-16 py-20 md:py-28">
    <div class="max-w-3xl mx-auto">
      <header
        class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] md:gap-x-12 lg:gap-x-16 gap-y-10 items-start"
      >
        <div class="space-y-7 order-2 md:order-1 min-w-0">
          <p
            class="text-[0.65rem] sm:text-xs font-medium uppercase tracking-[0.22em] text-muted-foreground anim-fade-up anim-d-1"
          >
            <span class="text-primary">§</span>&nbsp;Senior Cost Manager · Hyperscale Data Centers · Open-source builder
          </p>

          <h1
            class="text-[2.6rem] sm:text-6xl md:text-[5.25rem] lg:text-[5.75rem] font-bold tracking-[-0.04em] leading-[0.95] anim-fade-up anim-d-2"
          >
            Vitor M.<br />Rodovalho<span class="text-primary">.</span>
          </h1>

          <p class="text-lg sm:text-xl leading-snug font-medium anim-fade-up anim-d-3">
            Building cost intelligence for the&nbsp;<span class="link-soft">AI&#8209;infrastructure economy</span>.
          </p>

          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm pt-1 anim-fade-up anim-d-3">
            <li class="flex items-baseline gap-1.5">
              <span class="text-primary font-bold tnum">15+</span>
              <span class="text-muted-foreground">years</span>
            </li>
            <li class="flex items-baseline gap-1.5" aria-hidden="true">
              <span class="text-border-strong">·</span>
            </li>
            <li class="flex items-baseline gap-1.5">
              <span class="text-primary font-bold tnum">$6.7B+</span>
              <span class="text-muted-foreground">program scope</span>
            </li>
            <li class="flex items-baseline gap-1.5" aria-hidden="true">
              <span class="text-border-strong">·</span>
            </li>
            <li class="flex items-baseline gap-1.5">
              <span class="text-primary font-bold tnum">1,300+</span>
              <span class="text-muted-foreground">units delivered</span>
            </li>
            <li class="flex items-baseline gap-1.5" aria-hidden="true">
              <span class="text-border-strong">·</span>
            </li>
            <li class="flex items-baseline gap-1.5">
              <span class="text-primary font-bold tnum">6,151</span>
              <span class="text-muted-foreground">DAX measures</span>
            </li>
          </ul>

          <div
            class="space-y-4 text-[0.95rem] leading-relaxed text-muted-foreground anim-fade-up anim-d-4"
          >
            <p>
              Senior Cost Manager at <strong class="text-foreground">Linesight</strong>, supporting
              hyperscale data&#8209;center delivery. 15+ years across capital programs in the U.S.
              and Brazil — from <span class="tnum">$6.7B</span> Northeast Corridor rail (Amtrak / B&amp;P
              Tunnel) at AECOM, to <span class="tnum">$1B</span> higher&#8209;education bond programs,
              to <span class="tnum">1,300+</span> residential units delivered. Co&#8209;founder of the
              <strong class="text-foreground">AI &amp; PM Research Hub</strong> at PMI Brazil —
              a voluntary inter&#8209;chapter initiative on AI ⨯ Project Management with <span class="tnum">50+</span> volunteers across federated Brazilian chapters; author of its open&#8209;source platform and governance framework.
            </p>
          </div>

          <nav class="pt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm anim-fade-up anim-d-5">
            <a href="/experience" class="link-soft hover:text-foreground">Experience</a>
            <a href="/projects" class="link-soft hover:text-foreground">Projects</a>
            <a href="/portfolio" class="link-soft hover:text-foreground">Portfolio</a>
            <a href="/writing" class="link-soft hover:text-foreground">Writing</a>
            <a href="/recognition" class="link-soft hover:text-foreground">Recognition</a>
            <a href="/about" class="link-soft hover:text-foreground">About</a>
            <span class="text-border-strong" aria-hidden="true">·</span>
            <a
              href="https://www.linkedin.com/in/vitor-rodovalho-pmp"
              class="link-soft hover:text-foreground text-muted-foreground"
              rel="noopener">LinkedIn</a
            >
            <a
              href="https://github.com/VitorMRodovalho"
              class="link-soft hover:text-foreground text-muted-foreground"
              rel="noopener">GitHub</a
            >
            <a href="mailto:vitor@vitormr.dev" class="link-soft hover:text-foreground text-muted-foreground">Email</a>
          </nav>
        </div>

        <div class="order-1 md:order-2 anim-fade-up anim-d-2 md:pt-2">
          <Image
            src={headshot}
            alt="Portrait of Vitor M. Rodovalho"
            widths={[200, 240, 480]}
            sizes="(min-width: 768px) 240px, 200px"
            class="rounded-full w-[200px] md:w-[240px] aspect-square object-cover bg-muted"
            loading="eager"
            decoding="async"
          />
        </div>
      </header>

      <section class="mt-24 sm:mt-32 space-y-10 anim-fade-up anim-d-6">
        <div class="flex items-baseline justify-between border-b border-border pb-4">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight">What I'm building</h2>
          <span class="text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">
            Active projects
          </span>
        </div>

        <ol class="space-y-12">
          {
            featured.map((p, i) => (
              <li class="grid grid-cols-[auto_1fr] gap-x-5 sm:gap-x-8">
                <span class="section-num tnum pt-1">{String(i + 1).padStart(2, "0")}.</span>
                <div class="space-y-2.5 min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
                    <span class="role-pill">{p.role}</span>
                    <a
                      href={p.href}
                      class="text-xl sm:text-2xl font-bold tracking-tight link-soft"
                      rel="noopener"
                    >
                      {p.name}
                    </a>
                    {p.nameAlt && (
                      <span class="text-sm text-muted-foreground italic">({p.nameAlt})</span>
                    )}
                  </div>
                  <p class="text-sm font-medium text-muted-foreground">
                    <code class="text-foreground">{p.slug}/</code> · {p.tagline}
                  </p>
                  <p class="text-[0.95rem] leading-relaxed">{p.blurb}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="text-xs text-muted-foreground/85 pt-2 leading-relaxed">
          Plus <a
            href="https://github.com/VitorMRodovalho/SnipeScheduler-FleetManager"
            class="link-soft"
            rel="noopener">SnipeScheduler-FleetManager</a
          >
          (predecessor to Panorama, GPL-3.0), {" "}
          <a href="/portfolio/power-bi" class="link-soft">4 anonymized Power BI suites</a>{" "}
          (~6,151 DAX measures across Brazilian real-estate analytics), and {" "}
          <a href="https://github.com/VitorMRodovalho?tab=repositories" class="link-soft" rel="noopener">
            14 public repos
          </a> in total.
        </p>
      </section>
    </div>
  </main>

  <SiteFooter variant="home" />
</BaseLayout>
