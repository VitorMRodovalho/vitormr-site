---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * /experience — curated employment timeline.
 *
 * Source: Astro Content Collection `experience` (schema in `src/content.config.ts`).
 * 7 highlighted positions from a 9-position career — full chronology lives on
 * LinkedIn for completeness. Reverse-chronological with section-number anchors,
 * role-pill badges, and amber period accents per V02.5 design language.
 */

const allExperience = await getCollection("experience");
const experience = allExperience.sort((a, b) => a.data.order - b.data.order);

const INDUSTRY_LABEL: Record<(typeof experience)[number]["data"]["industry"], string> = {
  "data-center": "Data center",
  rail: "Rail infrastructure",
  "higher-ed": "Higher education",
  "real-estate": "Real estate",
  mining: "Mining",
};

const title = "Experience · Vitor M. Rodovalho";
const description =
  "Selected projects from Vitor M. Rodovalho's 15+ years delivering capital programs across the U.S. and Brazil — from $6.7B Northeast Corridor rail at AECOM to hyperscale data centers at Linesight to R$338M GDV in Brazilian residential development.";

const buildDate = new Date().toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description}>
  <main class="flex-1 px-6 sm:px-10 lg:px-16 py-20 md:py-28">
    <div class="max-w-3xl mx-auto space-y-16">
      <header class="space-y-5">
        <p
          class="text-[0.65rem] sm:text-xs font-medium uppercase tracking-[0.22em] text-muted-foreground"
        >
          <span class="text-primary">§</span>&nbsp;Experience
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.05]">
          Selected projects across infrastructure, real estate, and higher
          education<span class="text-primary">.</span>
        </h1>
        <p class="text-base text-muted-foreground leading-relaxed">
          Highlights from <span class="tnum">15+</span> years of capital-program
          delivery in the U.S. and Brazil — hyperscale data centers, Northeast
          Corridor rail, $1B higher-education bond programs, and Brazilian
          residential development. Full chronology on{" "}
          <a
            href="https://www.linkedin.com/in/vitor-rodovalho-pmp"
            class="link-soft"
            rel="noopener"
          >
            LinkedIn
          </a>
          .
        </p>
      </header>

      <section class="space-y-12">
        {
          experience.map((e, i) => (
            <article class="grid grid-cols-[auto_1fr] gap-x-5 sm:gap-x-8">
              <span class="section-num tnum pt-1">
                {String(i + 1).padStart(2, "0")}.
              </span>
              <div class="space-y-3 min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
                  <span class="text-[0.6rem] uppercase tracking-[0.18em] text-muted-foreground">
                    {INDUSTRY_LABEL[e.data.industry]}
                  </span>
                  {e.data.isCurrent && <span class="role-pill">Current</span>}
                  <span class="text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground tnum">
                    {e.data.period}
                  </span>
                  <span class="text-[0.7rem] text-muted-foreground/70">·</span>
                  <span class="text-[0.7rem] uppercase tracking-[0.15em] text-muted-foreground">
                    {e.data.location}
                  </span>
                </div>
                <h2 class="text-xl sm:text-2xl font-bold tracking-tight">
                  {e.data.role}
                </h2>
                <p class="text-sm font-medium">
                  {e.data.organizationUrl ? (
                    <a
                      href={e.data.organizationUrl}
                      class="link-soft"
                      rel="noopener"
                    >
                      {e.data.organization}
                    </a>
                  ) : (
                    e.data.organization
                  )}
                </p>
                <p class="text-[0.95rem] leading-relaxed">{e.data.summary}</p>
                {e.data.highlights.length > 0 && (
                  <ul class="space-y-2 text-sm leading-relaxed list-disc pl-5 marker:text-primary">
                    {e.data.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </section>
    </div>
  </main>

  <footer class="px-6 sm:px-10 lg:px-16 py-12 border-t border-border mt-16">
    <div class="max-w-3xl mx-auto space-y-4 text-center">
      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-1.5 text-xs">
        <a href="/" class="link-soft hover:text-foreground">← Home</a>
        <a href="/about" class="link-soft hover:text-foreground">About</a>
      </nav>
      <p class="build-stamp tnum">
        BUILD&nbsp;{buildDate}&nbsp;·&nbsp;ASTRO&nbsp;6.3&nbsp;·&nbsp;TAILWIND&nbsp;V4
      </p>
    </div>
  </footer>
</BaseLayout>
