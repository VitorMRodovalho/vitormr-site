---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page not found · Vitor M. Rodovalho";
const description = "The page you were looking for could not be found.";
---

<BaseLayout title={title} description={description}>
  <main class="flex-1 flex items-center justify-center px-6 sm:px-10 lg:px-16 py-20 md:py-28">
    <div class="max-w-md space-y-6 text-center">
      <p
        class="text-[0.65rem] sm:text-xs font-medium uppercase tracking-[0.22em] text-muted-foreground tnum"
      >
        <span class="text-primary">§</span>&nbsp;Error&nbsp;404
      </p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-[-0.04em] leading-[1.05]">
        The trade got squeezed<span class="text-primary">.</span>
      </h1>
      <p class="text-base text-muted-foreground leading-relaxed">
        This page doesn't exist, or someone hacked the planet and moved
        it. Either way, you're early. Or late.
      </p>
      <nav class="pt-4 flex justify-center text-sm">
        <a href="/" class="link-soft hover:text-foreground">← Home</a>
      </nav>
    </div>
  </main>
</BaseLayout>
