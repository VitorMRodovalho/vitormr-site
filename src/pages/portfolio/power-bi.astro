---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

/**
 * /portfolio/power-bi/ — Tier 2 catalog of 4 anonymized Power BI suites
 * (~6,151 DAX measures across Brazilian real-estate development + BPO
 * operations). Knowledge artifacts (DAX, M, schemas, relationships)
 * extracted from production .pbix; the .pbix files themselves are NOT
 * in the public repos.
 */

const allSuites = await getCollection("powerbi");
const suites = allSuites.sort((a, b) => a.data.order - b.data.order);

const totals = suites.reduce(
  (acc, s) => ({
    dashboards: acc.dashboards + s.data.dashboardCount,
    measures: acc.measures + s.data.totalMeasures,
  }),
  { dashboards: 0, measures: 0 },
);

const title = "Power BI Portfolio · Vitor M. Rodovalho";
const description =
  "Tier 2 anonymized Power BI artifacts — 4 production suites totaling 24 dashboards and ~6,151 DAX measures across Brazilian real-estate development and BPO financial operations. All MIT-licensed, all anonymized.";

const buildDate = new Date().toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description}>
  <main class="flex-1 px-6 sm:px-10 lg:px-16 py-20 md:py-28">
    <div class="max-w-3xl mx-auto space-y-16">
      <header class="space-y-5">
        <p
          class="text-[0.65rem] sm:text-xs font-medium uppercase tracking-[0.22em] text-muted-foreground"
        >
          <span class="text-primary">§</span>&nbsp;Portfolio · Power BI
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.05]">
          Anonymized Power BI artifacts<span class="text-primary">.</span>
        </h1>
        <p class="text-base text-muted-foreground leading-relaxed">
          Four production suites built for Brazilian real-estate development
          and BPO financial operations — extracted as knowledge artifacts
          (DAX measures, Power Query M, data-model schemas, relationships).
          The original <code class="text-foreground">.pbix</code> files are
          not in the public repos; the patterns and techniques are.
        </p>
        <dl class="grid grid-cols-3 gap-4 pt-4 max-w-md">
          <div>
            <dt class="text-[0.65rem] uppercase tracking-[0.18em] text-muted-foreground">
              Suites
            </dt>
            <dd class="text-2xl font-bold tracking-tight tnum mt-1">
              {suites.length}
            </dd>
          </div>
          <div>
            <dt class="text-[0.65rem] uppercase tracking-[0.18em] text-muted-foreground">
              Dashboards
            </dt>
            <dd class="text-2xl font-bold tracking-tight tnum mt-1">
              {totals.dashboards}
            </dd>
          </div>
          <div>
            <dt class="text-[0.65rem] uppercase tracking-[0.18em] text-muted-foreground">
              DAX measures
            </dt>
            <dd class="text-2xl font-bold tracking-tight tnum mt-1">
              {totals.measures.toLocaleString("en-US")}
            </dd>
          </div>
        </dl>
      </header>

      <section class="space-y-12">
        {
          suites.map((s, i) => (
            <article class="grid grid-cols-[auto_1fr] gap-x-5 sm:gap-x-8">
              <span class="section-num tnum pt-1">
                {String(i + 1).padStart(2, "0")}.
              </span>
              <div class="space-y-3 min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
                  <span class="role-pill">MIT</span>
                  <h2 class="text-xl sm:text-2xl font-bold tracking-tight">
                    {s.data.name}
                  </h2>
                </div>
                <p class="text-sm font-medium text-muted-foreground">
                  {s.data.tagline}
                </p>
                <p class="text-[0.95rem] leading-relaxed">{s.data.summary}</p>

                <details class="text-sm pt-2">
                  <summary class="cursor-pointer font-medium link-soft inline-block">
                    {s.data.dashboardCount} dashboards · {s.data.totalMeasures.toLocaleString("en-US")} DAX measures →
                  </summary>
                  <ul class="mt-3 space-y-1.5 pl-4 border-l border-border/60">
                    {s.data.dashboards.map((d) => (
                      <li class="flex flex-col gap-0.5">
                        <span class="flex items-baseline gap-2">
                          <span class="font-medium">{d.name}</span>
                          <span class="text-xs text-muted-foreground tnum">
                            · {d.measures.toLocaleString("en-US")} DAX
                          </span>
                        </span>
                        <span class="text-xs text-muted-foreground/85 leading-snug">
                          {d.focus}
                        </span>
                      </li>
                    ))}
                  </ul>
                </details>

                {s.data.highlights.length > 0 && (
                  <ul class="space-y-1.5 text-sm leading-relaxed list-disc pl-5 marker:text-primary pt-2">
                    {s.data.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}

                <div class="flex flex-wrap gap-x-2 gap-y-2 pt-2">
                  {s.data.techStack.map((tech) => (
                    <span class="text-[0.65rem] uppercase tracking-[0.12em] px-2 py-0.5 border border-border rounded-sm font-mono text-muted-foreground">
                      {tech}
                    </span>
                  ))}
                </div>

                <p class="text-xs pt-1">
                  <a
                    href={s.data.repoUrl}
                    class="link-soft hover:text-foreground"
                    rel="noopener"
                  >
                    GitHub repo ↗
                  </a>
                </p>
              </div>
            </article>
          ))
        }
      </section>
    </div>
  </main>

  <footer class="px-6 sm:px-10 lg:px-16 py-12 border-t border-border mt-16">
    <div class="max-w-3xl mx-auto space-y-4 text-center">
      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-1.5 text-xs">
        <a href="/" class="link-soft hover:text-foreground">← Home</a>
        <a href="/projects" class="link-soft hover:text-foreground">Projects</a>
        <a href="/experience" class="link-soft hover:text-foreground">Experience</a>
      </nav>
      <p class="build-stamp tnum">
        BUILD&nbsp;{buildDate}&nbsp;·&nbsp;ASTRO&nbsp;6.3&nbsp;·&nbsp;TAILWIND&nbsp;V4
      </p>
    </div>
  </footer>
</BaseLayout>
