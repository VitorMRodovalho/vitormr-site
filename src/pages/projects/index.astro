---
import { getCollection } from "astro:content";
import SiteFooter from "../../components/SiteFooter.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

/**
 * /projects — hub listing all Tier-1 projects with previews + links to
 * per-project case-study pages at /projects/[slug]/.
 */

const allProjects = await getCollection("projects");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const title = "Projects · Vitor M. Rodovalho";
const description =
  "Tier-1 projects led, authored, or maintained by Vitor M. Rodovalho — the AI & PM Research Hub at PMI Brazil, MeridianIQ open-source schedule intelligence, Panorama IT+fleet management, SnipeScheduler-FleetManager, and Orenu family fintech.";

---

<BaseLayout title={title} description={description}>
  <main class="flex-1 px-6 sm:px-10 lg:px-16 py-20 md:py-28">
    <div class="max-w-3xl mx-auto space-y-16">
      <header class="space-y-5">
        <p
          class="text-[0.65rem] sm:text-xs font-medium uppercase tracking-[0.22em] text-muted-foreground"
        >
          <span class="text-primary">§</span>&nbsp;Projects
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.05]">
          Things I've built<span class="text-primary">.</span>
        </h1>
        <p class="text-base text-muted-foreground leading-relaxed">
          Five Tier-1 projects spanning research-community infrastructure,
          schedule intelligence, IT/fleet management, and cross-border family
          fintech. Most are open-source. Each gets a case-study page with
          problem, approach, impact, stack, and links.
        </p>
      </header>

      <section class="space-y-12">
        {
          projects.map((p, i) => (
            <article class="grid grid-cols-[auto_1fr] gap-x-5 sm:gap-x-8">
              <span class="section-num tnum pt-1">
                {String(i + 1).padStart(2, "0")}.
              </span>
              <div class="space-y-3 min-w-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
                  <span class="role-pill">{p.data.role}</span>
                  <a
                    href={`/projects/${p.id}/`}
                    class="text-xl sm:text-2xl font-bold tracking-tight link-soft"
                  >
                    {p.data.name}
                  </a>
                  {p.data.nameAlt && (
                    <span class="text-sm text-muted-foreground italic">({p.data.nameAlt})</span>
                  )}
                </div>
                <p class="text-sm font-medium text-muted-foreground">
                  <code class="text-foreground">{p.id}/</code> · {p.data.tagline}
                </p>
                <p class="text-[0.95rem] leading-relaxed">{p.data.summary}</p>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs pt-1">
                  <a
                    href={`/projects/${p.id}/`}
                    class="link-soft hover:text-foreground"
                  >
                    Read case study →
                  </a>
                  {p.data.links?.live && (
                    <a
                      href={p.data.links.live}
                      class="link-soft hover:text-foreground text-muted-foreground"
                      rel="noopener"
                    >
                      Live ↗
                    </a>
                  )}
                  {p.data.links?.repo && (
                    <a
                      href={p.data.links.repo}
                      class="link-soft hover:text-foreground text-muted-foreground"
                      rel="noopener"
                    >
                      GitHub ↗
                    </a>
                  )}
                  <span class="text-muted-foreground/70">· {p.data.status}</span>
                </div>
              </div>
            </article>
          ))
        }
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
