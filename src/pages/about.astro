---
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * /about — biographical narrative bridging practitioner + builder + researcher.
 *
 * Five-phase career arc anchored in CV/LinkedIn. Parallel research/builder
 * thread surfaced explicitly. Education includes the UEG → PUC-GO transfer
 * detail (diploma at PUC; movimento estudantil + earlier projects at UEG).
 * Personal section keeps the human note light — open-source ethos + Linux
 * since 2006 + a few films — to give signal without self-indulgence.
 *
 * PII boundaries per ADR-023 §D8: no phone, no personal outlook, no salary,
 * no immigration case detail. Professional email vitor@vitormr.dev only.
 */

const title = "About · Vitor M. Rodovalho";
const description =
  "Vitor M. Rodovalho — Senior Cost Manager at Linesight. 15+ years across capital programs in the U.S. and Brazil. Founder of the AI & PM Research Hub at PMI Brazil. Open-source builder.";
---

<BaseLayout title={title} description={description}>
  <main class="flex-1 px-4 py-16 md:py-24">
    <div class="max-w-3xl mx-auto space-y-12">
      <header class="space-y-4">
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground">
          About
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">
          Construction practitioner. Open-source builder. Community of practice founder.
        </h1>
      </header>

      <section class="space-y-6 text-base leading-relaxed">
        <p>
          I'm a Senior Cost Manager at <strong>Linesight</strong>, supporting
          hyperscale data-center delivery in Northern Virginia. Civil engineer
          by training, project-management practitioner by trade, and an
          open-source builder by inclination — most of what I make is on
          GitHub under MIT, AGPL, or GPL.
        </p>
        <p>
          The thread that connects everything I've worked on for the last 15+
          years is the same: <strong>data-driven project controls applied to
          capital programs</strong>. From R$338M in residential developments in
          Brazil through the 2016-19 housing crisis, to $15B+ in real-estate
          AUM at Trinus Co (where I led integration of 50+ portfolio
          companies into a Databricks lakehouse and cut financial close from
          45 to 20 days), to a $1B U.S. higher-education bond program at
          AECOM California, to the $6.7B Amtrak Frederick Douglass / B&P
          Tunnel Replacement Program at AECOM Maryland (active member of the
          AI Working Group), to hyperscale data centers at Linesight today —
          the work has always been about turning messy program data into cost
          decisions you can defend.
        </p>
        <p>
          In parallel, I founded the <strong>AI & PM Research Hub</strong>
          (<a
            href="https://nucleoia.vitormr.dev"
            class="underline hover:text-foreground"
            rel="noopener"
          >Núcleo IA & GP</a>) at PMI Brazil in 2024 — what started as a
          pilot in PMI Goiás is now a structured alliance of five federated
          chapters with 52 active researchers across 7 research streams, 209
          events held, and an MCP-enabled platform with 266 tools. I also
          maintain <a
            href="https://meridianiq.vitormr.dev"
            class="underline hover:text-foreground"
            rel="noopener"
          >MeridianIQ</a> (open-source schedule intelligence, 48 analysis
          engines, 1,490+ tests, traceable to AACE / DCMA / SCL / GAO
          standards) and <a
            href="https://panorama.vitormr.dev"
            class="underline hover:text-foreground"
            rel="noopener"
          >Panorama</a> (open-source IT asset + fleet management, successor
          to Snipe-IT, multi-tenant, trilingual). And I designed and developed
          <a
            href="https://sarahrodovalho.com"
            class="underline hover:text-foreground"
            rel="noopener"
          >sarahrodovalho.com</a> for my wife Sarah, a sustainable-design and
          construction-management researcher at Harrisburg University.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Now</h2>
        <ul class="space-y-3 text-base leading-relaxed">
          <li>
            <strong>Senior Cost Manager</strong> at{" "}
            <strong>Linesight</strong> · Sterling, VA · April 2026 – present.
            Hyperscale data-center cost delivery.
          </li>
          <li>
            <strong>Founder + Project Manager</strong> · The AI & PM Research
            Hub (Núcleo IA & GP) at PMI Brazil · since 2024 · 52 active
            researchers · 5 federated chapters.
          </li>
          <li>
            <strong>Author / Maintainer</strong> · MeridianIQ (open-source
            schedule intelligence) · v4.2.0 in production at{" "}
            <a
              href="https://meridianiq.vitormr.dev"
              class="underline hover:text-foreground"
              rel="noopener"
            >meridianiq.vitormr.dev</a>.
          </li>
          <li>
            <strong>Maintainer</strong> · Panorama (open-source IT/fleet
            management) · pre-alpha pilot prep at{" "}
            <a
              href="https://panorama.vitormr.dev"
              class="underline hover:text-foreground"
              rel="noopener"
            >panorama.vitormr.dev</a>.
          </li>
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Career arc</h2>
        <ul class="space-y-4 text-base leading-relaxed">
          <li>
            <strong>2007 – 2010 · Foundation</strong> — Started as an
            assistant project manager at EMISA Incorporadora (Anápolis-GO,
            Brazil) during my Civil Engineering studies. Field coordination on
            the $1.9B Barro Alto Nickel Mine Project (Anglo American /
            SNC-Lavalin-Minerconsult consortium) at FR Incorporadora.
          </li>
          <li>
            <strong>2010 – 2019 · Building scale</strong> — Procurement Manager
            at Direcional Engenharia (Brazil's largest homebuilder) — R$89M
            across 412 contract packages, 10.3% below budget. Then back to
            EMISA: Construction Manager → Project Manager → Project Manager.
            Across these roles delivered 1,300+ housing units, R$338M GDV,
            1.8M sq ft of construction. Navigated the 2016-19 Brazilian
            housing-market downturn while keeping projects profitable.
          </li>
          <li>
            <strong>2020 – 2023 · Digital transformation</strong> — Business
            Process Specialist at Trinus Co, part of TG Core Asset ($15B+ AUM
            real-estate investment platform). Built a 10-engineer PMO
            validating budgets and schedules across 300+ invested projects.
            Integrated data from 50+ portfolio companies — each with its own
            ERP/CRM stack — into a centralized Databricks lakehouse with
            unified cost-center hierarchies. Reduced monthly financial close
            from 45 to 20 days (~55%) and improved reporting efficiency by
            ~70%. Promoted to Partner in the BPO subsidiary within 3 months.
          </li>
          <li>
            <strong>2024 – early 2026 · U.S. infrastructure</strong> — Project
            Controls Lead at AECOM California for a $1B college-district
            bond program (4 colleges + district office). Then Digital
            Solutions Business Analyst at AECOM Maryland on the $6.7B Amtrak
            Frederick Douglass / B&P Tunnel Replacement Program (Northeast
            Corridor modernization for 12M+ annual passengers; AECOM-Jacobs
            joint venture as Delivery Partner). Active member of the AI
            Working Group. Led PMIS data migration at Great Lakes Water
            Authority (Kahua); additional exposure on Metrolinx, FEMA USVI,
            and United Airlines programs.
          </li>
          <li>
            <strong>2026 – present · AI-infrastructure economy</strong> —
            Senior Cost Manager at Linesight, supporting hyperscale data-center
            delivery in Northern Virginia. Working at the cost-management
            layer of the physical infrastructure that powers AI and cloud.
          </li>
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Parallel research thread</h2>
        <p class="text-base leading-relaxed">
          Since 2023, in parallel with my employment, I've been building a
          community of practice and a stack of open-source tools at the
          intersection of project management and AI:
        </p>
        <ul class="space-y-3 text-base leading-relaxed">
          <li>
            <strong>2023</strong> — Joined the Study and Research Center for
            AI and Project Management at PMI Brazil Goiás.
          </li>
          <li>
            <strong>2024</strong> — Founded the AI & PM Research Hub (Núcleo
            IA & GP) as a pilot within PMI Goiás. Microsoft Global Hackathon
            participant.
          </li>
          <li>
            <strong>2025-2026</strong> — Núcleo IA & GP grows into a
            five-chapter federation (PMI-GO, PMI-CE, PMI-DF, PMI-MG, PMI-RS)
            with 52 active researchers and an MCP-enabled platform. MeridianIQ
            ships from v0.1 to v4.2.0 as production-grade open-source schedule
            intelligence. Panorama bootstraps as the unified successor to
            Snipe-IT plus a fleet-scheduling overlay.
          </li>
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Education</h2>
        <ul class="space-y-2 text-base leading-relaxed">
          <li>
            <strong>Executive Program in Innovative Project Management &
            Business English</strong> · College of Business, The University of
            Akron, Ohio · Feb – Mar 2022 · LAIOB Scholarship recipient
          </li>
          <li>
            <strong>Executive MBA in Real Estate Business & Construction
            Management</strong> · Fundação Getulio Vargas (FGV), Brasília ·
            2012 – 2016 · Direcional +Educação Scholarship recipient
          </li>
          <li>
            <strong>Bachelor of Civil Engineering</strong> · Pontifícia
            Universidade Católica de Goiás · diploma awarded 2010 (started at
            Universidade Estadual de Goiás and transferred mid-program;
            community work and student-government experience all from the UEG
            years — see{" "}
            <a
              href="https://github.com/VitorMRodovalho/movimento-estudantil-ueg"
              class="underline hover:text-foreground"
              rel="noopener"
            >movimento-estudantil-ueg</a>{" "}
            archive)
          </li>
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Certifications & memberships</h2>
        <ul class="space-y-2 text-base leading-relaxed">
          <li>Project Management Professional (PMP®) · PMI member</li>
          <li>Construction Management Association of America (CMAA) member</li>
          <li>Licensed Civil Engineer in Brazil (CREA-GO / CONFEA)</li>
          <li>
            AI courses: PMI Talking to AI: Prompt Engineering · PMI Generative
            AI Overview · Generative AI Prompt Engineering Basics ·
            AI-Driven PM Techniques (Ricardo Vargas)
          </li>
          <li>
            Cloud / sustainability: Microsoft Cloud for Sustainability ·
            Career Essentials in Sustainable Tech · Including Sustainability
            in Cloud Strategy
          </li>
          <li>Construction Scheduling · Business Analysis Foundations · Data Analytics</li>
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Languages</h2>
        <p class="text-base leading-relaxed">
          Portuguese (native or bilingual) · English (professional working) ·
          Spanish (elementary)
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Personal</h2>
        <p class="text-base leading-relaxed">
          Linux user since 2006 (Slackware roots — old-school
          rebuild-it-yourself ethos). Open-source as both ethics and
          economics: almost all of what I make ships under MIT, AGPL, or GPL.
          Films I revisit: <em>Hackers</em>, <em>Margin Call</em>,
          <em>The Big Short</em>, <em>The Wolf of Wall Street</em>,
          <em>Rocky</em>. TV: <em>Silicon Valley</em>. Believer in builders
          who keep going long after the camera stops rolling.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold tracking-tight">Contact</h2>
        <ul class="space-y-2 text-base leading-relaxed">
          <li>
            Email: <a href="mailto:vitor@vitormr.dev" class="underline hover:text-foreground">vitor@vitormr.dev</a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/vitor-rodovalho-pmp"
              class="underline hover:text-foreground"
              rel="noopener"
            >
              LinkedIn / vitor-rodovalho-pmp
            </a>
          </li>
          <li>
            <a
              href="https://github.com/VitorMRodovalho"
              class="underline hover:text-foreground"
              rel="noopener"
            >
              GitHub / VitorMRodovalho
            </a>
          </li>
        </ul>
        <p class="text-sm text-muted-foreground/80">
          Based in Leesburg, VA · Washington DC – Baltimore region.
        </p>
      </section>

      <footer class="pt-8 text-xs text-muted-foreground/60 text-center">
        <a href="/" class="underline hover:text-foreground">← Home</a>
      </footer>
    </div>
  </main>
</BaseLayout>
