---
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * /about — bio narrative with V02.5 design pass applied: section-number
 * anchors per phase, hi-vis amber period accents in h1, role-pill badges
 * in Now section, link-soft underlines on all inline links, build stamp
 * footer pattern.
 *
 * PII boundaries per ADR-023 §D8: no phone, no personal outlook, no salary,
 * no immigration case detail. Professional email vitor@vitormr.dev only.
 */

const title = "About · Vitor M. Rodovalho";
const description =
  "Vitor M. Rodovalho — Senior Cost Manager at Linesight. 15+ years across capital programs in the U.S. and Brazil. Founder of the AI & PM Research Hub at PMI Brazil. Open-source builder.";

const careerArc = [
  {
    num: "01",
    period: "2007 – 2010",
    title: "Foundation",
    body: "Started as an assistant project manager at EMISA Incorporadora (Anápolis-GO, Brazil) during my Civil Engineering studies. Field coordination on the $1.9B Barro Alto Nickel Mine Project (Anglo American / SNC-Lavalin-Minerconsult consortium) at FR Incorporadora.",
  },
  {
    num: "02",
    period: "2010 – 2019",
    title: "Building scale",
    body: "Procurement Manager at Direcional Engenharia (Brazil's largest homebuilder) — R$89M across 412 contract packages, 10.3% below budget. Then back to EMISA: Construction Manager → Project Manager → Project Manager. Across these roles delivered 1,300+ housing units, R$338M GDV, 1.8M sq ft of construction. Navigated the 2016-19 Brazilian housing-market downturn while keeping projects profitable.",
  },
  {
    num: "03",
    period: "2020 – 2023",
    title: "Digital transformation",
    body: "Business Process Specialist at Trinus Co, part of TG Core Asset ($15B+ AUM real-estate investment platform). Built a 10-engineer PMO validating budgets and schedules across 300+ invested projects. Integrated data from 50+ portfolio companies — each with its own ERP/CRM stack — into a centralized Databricks lakehouse with unified cost-center hierarchies. Reduced monthly financial close from 45 to 20 days (~55%) and improved reporting efficiency by ~70%. Promoted to Partner in the BPO subsidiary within 3 months.",
  },
  {
    num: "04",
    period: "2024 – early 2026",
    title: "U.S. infrastructure",
    body: "Project Controls Lead at AECOM California for a $1B college-district bond program (4 colleges + district office). Then Digital Solutions Business Analyst at AECOM Maryland on the $6.7B Amtrak Frederick Douglass / B&P Tunnel Replacement Program (Northeast Corridor modernization for 12M+ annual passengers; AECOM-Jacobs joint venture as Delivery Partner). Active member of the AI Working Group. Led PMIS data migration at Great Lakes Water Authority (Kahua); additional exposure on Metrolinx, FEMA USVI, and United Airlines programs.",
  },
  {
    num: "05",
    period: "2026 – present",
    title: "AI-infrastructure economy",
    body: "Senior Cost Manager at Linesight, supporting hyperscale data-center delivery in Northern Virginia. Working at the cost-management layer of the physical infrastructure that powers AI and cloud.",
  },
];

const buildDate = new Date().toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description}>
  <main class="flex-1 px-6 sm:px-10 lg:px-16 py-20 md:py-28">
    <div class="max-w-3xl mx-auto space-y-20">
      <header class="space-y-5">
        <p class="text-[0.65rem] sm:text-xs font-medium uppercase tracking-[0.22em] text-muted-foreground">
          <span class="text-primary">§</span>&nbsp;About
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.05]">
          Construction practitioner.<br />
          Open-source builder.<br />
          Community of practice founder<span class="text-primary">.</span>
        </h1>
      </header>

      <section class="space-y-5 text-[0.95rem] leading-relaxed">
        <p>
          I'm a Senior Cost Manager at <strong>Linesight</strong>, supporting hyperscale data-center
          delivery in Northern Virginia. Civil engineer by training, project-management practitioner
          by trade, and an open-source builder by inclination — most of what I make is on GitHub
          under MIT, AGPL, or GPL.
        </p>
        <p>
          The thread that connects everything I've worked on for the last 15+ years is the same:
          <strong>data-driven project controls applied to capital programs</strong>. From R$338M in
          residential developments in Brazil through the 2016-19 housing crisis, to $15B+ in
          real-estate AUM at Trinus Co (where I led integration of 50+ portfolio companies into a
          Databricks lakehouse and cut financial close from 45 to 20 days), to a $1B U.S.
          higher-education bond program at AECOM California, to the $6.7B Amtrak Frederick Douglass
          / B&amp;P Tunnel Replacement Program at AECOM Maryland (active member of the AI Working
          Group), to hyperscale data centers at Linesight today — the work has always been about
          turning messy program data into cost decisions you can defend.
        </p>
        <p>
          In parallel, I founded the <strong>AI &amp; PM Research Hub</strong>
          (<a href="https://nucleoia.vitormr.dev" class="link-soft" rel="noopener"
            >Núcleo IA &amp; GP</a
          >) at PMI Brazil in 2024 — what started as a pilot in PMI Goiás is now a structured
          alliance of five federated chapters with 52 active researchers across 7 research streams,
          209 events held, and an MCP-enabled platform with 266 tools. I also maintain
          <a href="https://meridianiq.vitormr.dev" class="link-soft" rel="noopener">MeridianIQ</a>
          (open-source schedule intelligence, 48 analysis engines, 1,490+ tests, traceable to AACE
          / DCMA / SCL / GAO standards) and
          <a href="https://panorama.vitormr.dev" class="link-soft" rel="noopener">Panorama</a>
          (open-source IT asset + fleet management, successor to Snipe-IT, multi-tenant, trilingual).
          And I designed and developed
          <a href="https://sarahrodovalho.com" class="link-soft" rel="noopener">sarahrodovalho.com</a>
          for my wife Sarah, a sustainable-design and construction-management researcher at Harrisburg
          University.
        </p>
      </section>

      <section class="space-y-6">
        <div class="flex items-baseline justify-between border-b border-border pb-3">
          <h2 class="text-xl font-bold tracking-tight">Now</h2>
          <span class="text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">
            Active anchors
          </span>
        </div>
        <ul class="space-y-4 text-[0.95rem] leading-relaxed">
          <li class="flex items-baseline gap-3 flex-wrap">
            <span class="role-pill">Senior Cost Mgr</span>
            <span>
              <a href="https://www.linesight.com" class="link-soft" rel="noopener"
                ><strong>Linesight</strong></a
              > · Sterling, VA · <span class="tnum">April 2026</span> – present. Hyperscale data-center
              cost delivery.
            </span>
          </li>
          <li class="flex items-baseline gap-3 flex-wrap">
            <span class="role-pill">Founder</span>
            <span>
              <a href="https://nucleoia.vitormr.dev" class="link-soft" rel="noopener"
                ><strong>AI &amp; PM Research Hub</strong></a
              >
              <em class="text-muted-foreground">(Núcleo IA &amp; GP)</em> at PMI Brazil · since
              <span class="tnum">2024</span> · 52 active researchers · 5 federated chapters.
            </span>
          </li>
          <li class="flex items-baseline gap-3 flex-wrap">
            <span class="role-pill">Author</span>
            <span>
              <a href="https://meridianiq.vitormr.dev" class="link-soft" rel="noopener"
                ><strong>MeridianIQ</strong></a
              > — open-source schedule intelligence · v4.2.0 in production.
            </span>
          </li>
          <li class="flex items-baseline gap-3 flex-wrap">
            <span class="role-pill">Author</span>
            <span>
              <a href="https://panorama.vitormr.dev" class="link-soft" rel="noopener"
                ><strong>Panorama</strong></a
              > — open-source IT/fleet management · pre-alpha pilot prep.
            </span>
          </li>
          <li class="flex items-baseline gap-3 flex-wrap">
            <span class="role-pill">Founder</span>
            <span>
              <a href="https://orenu.vitormr.dev" class="link-soft" rel="noopener"
                ><strong>Orenu</strong></a
              > — family fintech (4 pillars · AI-anchored) · private platform.
            </span>
          </li>
        </ul>
      </section>

      <section class="space-y-8">
        <div class="flex items-baseline justify-between border-b border-border pb-3">
          <h2 class="text-xl font-bold tracking-tight">Career arc</h2>
          <span class="text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">
            Five phases · 2007 – present
          </span>
        </div>
        <ol class="space-y-8">
          {
            careerArc.map((phase) => (
              <li class="grid grid-cols-[auto_1fr] gap-x-5 sm:gap-x-8">
                <span class="section-num tnum pt-1">{phase.num}.</span>
                <div class="space-y-2 min-w-0">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="text-[0.7rem] uppercase tracking-[0.18em] text-muted-foreground tnum">
                      {phase.period}
                    </span>
                    <h3 class="text-lg font-semibold tracking-tight">{phase.title}</h3>
                  </div>
                  <p class="text-[0.95rem] leading-relaxed">{phase.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="space-y-6">
        <div class="flex items-baseline justify-between border-b border-border pb-3">
          <h2 class="text-xl font-bold tracking-tight">Parallel research thread</h2>
          <span class="text-[0.65rem] uppercase tracking-[0.2em] text-muted-foreground">
            <span class="tnum">2023</span> – present
          </span>
        </div>
        <p class="text-[0.95rem] leading-relaxed">
          Since 2023, in parallel with my employment, I've been building a community of practice
          and a stack of open-source tools at the intersection of project management and AI:
        </p>
        <ul class="space-y-3 text-[0.95rem] leading-relaxed">
          <li>
            <strong class="tnum">2023</strong> — Joined the Study and Research Center for AI and
            Project Management at PMI Brazil Goiás.
          </li>
          <li>
            <strong class="tnum">2024</strong> — Founded the AI &amp; PM Research Hub
            <em class="text-muted-foreground">(Núcleo IA &amp; GP)</em> as a pilot within PMI
            Goiás. Microsoft Global Hackathon participant.
          </li>
          <li>
            <strong class="tnum">2025-2026</strong> — Núcleo IA &amp; GP grows into a five-chapter
            federation (PMI-GO, PMI-CE, PMI-DF, PMI-MG, PMI-RS) with 52 active researchers and an
            MCP-enabled platform. MeridianIQ ships from v0.1 to v4.2.0 as production-grade
            open-source schedule intelligence. Panorama bootstraps as the unified successor to
            Snipe-IT plus a fleet-scheduling overlay.
          </li>
        </ul>
      </section>

      <section class="space-y-6">
        <div class="flex items-baseline justify-between border-b border-border pb-3">
          <h2 class="text-xl font-bold tracking-tight">Education</h2>
        </div>
        <ul class="space-y-3 text-[0.95rem] leading-relaxed">
          <li>
            <span class="text-[0.7rem] uppercase tracking-[0.18em] text-muted-foreground tnum">
              Feb – Mar 2022
            </span><br />
            <strong>Executive Program in Innovative Project Management &amp; Business English</strong> ·
            College of Business, The University of Akron, Ohio · LAIOB Scholarship recipient
          </li>
          <li>
            <span class="text-[0.7rem] uppercase tracking-[0.18em] text-muted-foreground tnum">
              2012 – 2016
            </span><br />
            <strong>Executive MBA in Real Estate Business &amp; Construction Management</strong> ·
            Fundação Getulio Vargas (FGV), Brasília · Direcional +Educação Scholarship recipient
          </li>
          <li>
            <span class="text-[0.7rem] uppercase tracking-[0.18em] text-muted-foreground tnum">
              2004 – 2010
            </span><br />
            <strong>Bachelor of Civil Engineering</strong> · Pontifícia Universidade Católica de
            Goiás · diploma awarded 2010 (started at Universidade Estadual de Goiás and transferred
            mid-program; community work and student-government experience all from the UEG years —
            see {" "}
            <a
              href="https://github.com/VitorMRodovalho/movimento-estudantil-ueg"
              class="link-soft"
              rel="noopener">movimento-estudantil-ueg</a
            > archive)
          </li>
        </ul>
      </section>

      <section class="space-y-6">
        <div class="flex items-baseline justify-between border-b border-border pb-3">
          <h2 class="text-xl font-bold tracking-tight">Certifications &amp; memberships</h2>
        </div>
        <ul class="space-y-2 text-[0.95rem] leading-relaxed">
          <li>Project Management Professional (PMP®) · PMI member</li>
          <li>Construction Management Association of America (CMAA) member</li>
          <li>Licensed Civil Engineer in Brazil (CREA-GO / CONFEA)</li>
          <li>
            AI courses: PMI Talking to AI: Prompt Engineering · PMI Generative AI Overview ·
            Generative AI Prompt Engineering Basics · AI-Driven PM Techniques (Ricardo Vargas)
          </li>
          <li>
            Cloud / sustainability: Microsoft Cloud for Sustainability · Career Essentials in
            Sustainable Tech · Including Sustainability in Cloud Strategy
          </li>
          <li>Construction Scheduling · Business Analysis Foundations · Data Analytics</li>
        </ul>
      </section>

      <section class="space-y-6">
        <div class="flex items-baseline justify-between border-b border-border pb-3">
          <h2 class="text-xl font-bold tracking-tight">Languages</h2>
        </div>
        <p class="text-[0.95rem] leading-relaxed">
          Portuguese (native or bilingual) · English (professional working) · Spanish (elementary)
        </p>
      </section>

      <section class="space-y-6">
        <div class="flex items-baseline justify-between border-b border-border pb-3">
          <h2 class="text-xl font-bold tracking-tight">Personal</h2>
        </div>
        <p class="text-[0.95rem] leading-relaxed">
          Linux user since <span class="tnum">2006</span> (Slackware roots — old-school
          rebuild-it-yourself ethos). Open-source as both ethics and economics: almost all of
          what I make ships under MIT, AGPL, or GPL. Films I revisit:
          <em class="text-foreground">Hackers</em>, <em class="text-foreground">Margin Call</em>,
          <em class="text-foreground">The Big Short</em>,
          <em class="text-foreground">The Wolf of Wall Street</em>,
          <em class="text-foreground">Rocky</em>. TV:
          <em class="text-foreground">Silicon Valley</em>. Believer in builders who keep going long
          after the camera stops rolling.
        </p>
      </section>

      <section class="space-y-6">
        <div class="flex items-baseline justify-between border-b border-border pb-3">
          <h2 class="text-xl font-bold tracking-tight">Contact</h2>
        </div>
        <ul class="space-y-2.5 text-[0.95rem] leading-relaxed">
          <li>
            <span class="text-muted-foreground">Email&nbsp;</span>
            <a href="mailto:vitor@vitormr.dev" class="link-soft">
              <code class="text-foreground">vitor@vitormr.dev</code>
            </a>
          </li>
          <li>
            <span class="text-muted-foreground">LinkedIn&nbsp;</span>
            <a
              href="https://www.linkedin.com/in/vitor-rodovalho-pmp"
              class="link-soft"
              rel="noopener"
            >
              <code class="text-foreground">/in/vitor-rodovalho-pmp</code>
            </a>
          </li>
          <li>
            <span class="text-muted-foreground">GitHub&nbsp;</span>
            <a href="https://github.com/VitorMRodovalho" class="link-soft" rel="noopener">
              <code class="text-foreground">@VitorMRodovalho</code>
            </a>
          </li>
        </ul>
        <p class="text-sm text-muted-foreground">
          Based in Leesburg, VA · Washington DC – Baltimore region.
        </p>
      </section>
    </div>
  </main>

  <footer class="px-6 sm:px-10 lg:px-16 py-12 border-t border-border mt-16">
    <div class="max-w-3xl mx-auto space-y-4 text-center">
      <a href="/" class="text-xs link-soft hover:text-foreground">← Home</a>
      <p class="build-stamp tnum">
        BUILD&nbsp;{buildDate}&nbsp;·&nbsp;ASTRO&nbsp;6.3&nbsp;·&nbsp;TAILWIND&nbsp;V4
      </p>
    </div>
  </footer>
</BaseLayout>
