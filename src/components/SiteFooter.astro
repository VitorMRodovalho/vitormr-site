---
/**
 * SiteFooter — canonical site-wide footer to enforce nav consistency
 * across all pages.
 *
 * Variants:
 *   - "home"    → sibling-sites strip + build stamp (used on /)
 *   - "subpage" → single-row top-level nav + build stamp (all other pages)
 *
 * Top-level route list is the single source of truth here. If a new
 * top-level page lands, edit ONE file (this one).
 */

interface Props {
  variant?: "home" | "subpage";
}

const { variant = "subpage" } = Astro.props;
const buildDate = new Date().toISOString().slice(0, 10);

const siblingSites = [
  { href: "https://nucleoia.vitormr.dev", label: "nucleoia.vitormr.dev" },
  { href: "https://meridianiq.vitormr.dev", label: "meridianiq.vitormr.dev" },
  { href: "https://panorama.vitormr.dev", label: "panorama.vitormr.dev" },
  { href: "https://orenu.vitormr.dev", label: "orenu.vitormr.dev" },
  { href: "https://sarahrodovalho.com", label: "sarahrodovalho.com" },
];

const topLevelNav = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/experience", label: "Experience" },
  { href: "/projects", label: "Projects" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/writing", label: "Writing" },
  { href: "/recognition", label: "Recognition" },
];
---

{
  variant === "home" ? (
    <footer class="px-6 sm:px-10 lg:px-16 py-12 border-t border-border mt-16">
      <div class="max-w-3xl mx-auto space-y-6">
        <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-xs text-muted-foreground">
          {siblingSites.map((s) => (
            <li>
              <a
                href={s.href}
                class="link-soft hover:text-foreground"
                rel="noopener"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="build-stamp tnum">
          BUILD&nbsp;{buildDate}&nbsp;·&nbsp;ASTRO&nbsp;6.3&nbsp;·&nbsp;TAILWIND&nbsp;V4&nbsp;·&nbsp;©
          {new Date().getFullYear()}&nbsp;VITOR&nbsp;M.&nbsp;RODOVALHO
        </p>
        <p class="build-stamp tnum">
          <a href="/privacy" class="link-soft hover:text-foreground">Privacy</a>
        </p>
      </div>
    </footer>
  ) : (
    <footer class="px-6 sm:px-10 lg:px-16 py-12 border-t border-border mt-16">
      <div class="max-w-3xl mx-auto space-y-4 text-center">
        <nav class="flex flex-wrap justify-center gap-x-5 gap-y-1.5 text-xs">
          {topLevelNav.map((item) => (
            <a href={item.href} class="link-soft hover:text-foreground">
              {item.label}
            </a>
          ))}
        </nav>
        <p class="build-stamp tnum">
          BUILD&nbsp;{buildDate}&nbsp;·&nbsp;ASTRO&nbsp;6.3&nbsp;·&nbsp;TAILWIND&nbsp;V4
        </p>
        <p class="build-stamp tnum">
          <a href="/privacy" class="link-soft hover:text-foreground">Privacy</a>
        </p>
      </div>
    </footer>
  )
}
