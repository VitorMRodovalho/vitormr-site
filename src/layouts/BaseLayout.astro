---
/**
 * BaseLayout — site-wide HTML wrapper with metadata + Schema.org Person.
 *
 * Person markup includes occupation, affiliation (Linesight), co-founder
 * role at Núcleo IA & GP (with separate authorship of its platform and
 * management framework), and `sameAs` cross-links to LinkedIn + GitHub
 * for Knowledge Graph entity-resolution.
 */

import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import WatermarkLayer from "../components/WatermarkLayer.astro";

interface Props {
  title: string;
  description: string;
  /**
   * Ambient watermark variant. Per-page mapping in
   * `src/components/WatermarkLayer.astro`. Defaults to `"none"` —
   * pages opt in explicitly so density-heavy pages (e.g. /recognition,
   * /about) stay clean.
   */
  watermark?: "home" | "dax" | "none";
  /**
   * Optional Schema.org JSON-LD payload(s) appended AFTER the default Person
   * markup. Single object or array. Per-page enrichment (e.g.,
   * SoftwareApplication on /projects/[slug], CollectionPage on /portfolio/*,
   * extended Person on /recognition). Search engines aggregate same-entity
   * Person blocks via shared `url` + `sameAs`.
   */
  schemaJsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, watermark = "none", schemaJsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const extraSchemas: Record<string, unknown>[] = schemaJsonLd
  ? Array.isArray(schemaJsonLd)
    ? schemaJsonLd
    : [schemaJsonLd]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Theme bootstrap: blocking script that resolves localStorage into
         an explicit data-theme attr on <html> BEFORE first paint.
         Prevents FOUC; single source of truth so CSS uses [data-theme="dark"]
         selector (no @media branch). Default is LIGHT — system preference is
         only honored when user explicitly opts into "system" via the toggle
         island. Dark is reachable by setting localStorage.theme = "dark"
         manually. -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          let resolved = "light";
          if (saved === "dark" || saved === "light") {
            resolved = saved;
          } else if (saved === "system") {
            resolved = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.dataset.theme = resolved;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    <!-- Google Fonts — JetBrains Mono (display/chrome/mono) + Atkinson
         Hyperlegible (body sans). Loaded via <link> tags rather than
         CSS @import because Tailwind v4 + Vite strips @import url()
         directives during bundling — relying on @import = fonts never
         reach the browser. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Vitor Maia Rodovalho",
        alternateName: ["Vitor M. Rodovalho", "Vitor Rodovalho"],
        url: "https://vitormr.dev",
        sameAs: [
          "https://www.linkedin.com/in/vitor-rodovalho-pmp",
          "https://github.com/VitorMRodovalho",
        ],
        jobTitle: "Senior Cost Manager",
        worksFor: {
          "@type": "Organization",
          name: "Linesight",
          url: "https://www.linesight.com",
        },
        affiliation: [
          {
            "@type": "Organization",
            name: "Project Management Institute (PMI)",
            url: "https://www.pmi.org",
          },
          {
            "@type": "Organization",
            name: "Construction Management Association of America (CMAA)",
            url: "https://www.cmaanet.org",
          },
        ],
        knowsAbout: [
          "Data Center Construction",
          "Cost Management",
          "Project Controls",
          "Power BI",
          "Databricks",
          "Primavera P6",
          "PMIS Integration",
          "AI in Project Management",
          "Capital Program Delivery",
          "Construction Economics",
        ],
        hasCredential: [
          { "@type": "EducationalOccupationalCredential", name: "Project Management Professional (PMP)" },
          { "@type": "EducationalOccupationalCredential", name: "Licensed Civil Engineer (Brazil, CONFEA)" },
        ],
      })}
    />

    {
      extraSchemas.map((s) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(s)}
        />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <WatermarkLayer variant={watermark} />
    <ThemeToggle />
    <slot />
  </body>
</html>
